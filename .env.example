# Lo más simple: ./generar_env.sh crea .env con contraseñas aleatorias.
# Si lo haces a mano: cp .env.example .env y usa solo letras y números.
# MYSQL_PASSWORD, POSTGRES_PASSWORD y MONGO_PASSWORD se copian luego al .env
# de Backend A, Backend B y VM4 (por Session Manager, nunca por chat ni GitHub).
MYSQL_ROOT_PASSWORD=REEMPLAZAR
MYSQL_PASSWORD=REEMPLAZAR
POSTGRES_PASSWORD=REEMPLAZAR
MONGO_ROOT_PASSWORD=REEMPLAZAR
MONGO_PASSWORD=REEMPLAZAR
